{
  "name": "gumpkestra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check-shaders": "node scripts/check-shaders.mjs",
    "check-hdr": "node scripts/check-hdr.mjs",
    "check-meshes": "node scripts/check-mesh-visibility.mjs",
    "check-tiles": "node scripts/check-tile-sequence.mjs",
    "check-presets": "node scripts/check-presets.mjs",
    "check-timer": "node scripts/check-preset-timer.mjs",
    "check-message": "node scripts/check-message.mjs",
    "check-params": "node scripts/check-param-groups.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
